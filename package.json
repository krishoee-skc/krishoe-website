{
  "name": "kshreer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "check": "npm run type-check && npm run lint && npm run test:run && npm run build:ci",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "typecheck": "npm run type-check",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:run": "vitest run",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:ci": "node scripts/build-ci.mjs",
    "backup:export": "node scripts/export-admin-backup.mjs",
    "db:schema": "node scripts/apply-postgres-schema.mjs",
    "db:migrate:factory": "node scripts/apply-postgres-schema.mjs --migrations-only",
    "db:factory-preflight": "node scripts/factory-migration-preflight.mjs",
    "db:factory-backup": "node scripts/export-factory-migration-backup.mjs",
    "db:access-backup": "node scripts/export-access-branch-migration-backup.mjs",
    "audit:production": "node --env-file=.env.local scripts/audit-production-integrity.mjs",
    "audit:access": "node scripts/audit-admin-access-branch.mjs",
    "db:import": "node scripts/import-backup-to-postgres.mjs",
    "db:smoke": "node scripts/postgres-smoke-check.mjs",
    "business:clean-start": "node scripts/clean-business-start.mjs"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@vercel/blob": "^2.6.1",
    "@vercel/postgres": "^0.10.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bwip-js": "^4.11.2",
    "nepali-date-converter": "^3.4.0",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "twilio": "^4.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
