{
  "name": "kshreer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --watch",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:all": "jest",
    "test:coverage": "jest --coverage",
    "backup:export": "node scripts/export-admin-backup.mjs",
    "db:schema": "node scripts/apply-postgres-schema.mjs",
    "db:migrate:factory": "node scripts/apply-postgres-schema.mjs --migrations-only",
    "db:factory-preflight": "node scripts/factory-migration-preflight.mjs",
    "db:factory-backup": "node scripts/export-factory-migration-backup.mjs",
    "db:access-backup": "node scripts/export-access-branch-migration-backup.mjs",
    "audit:production": "node --env-file=.env.local scripts/audit-production-integrity.mjs",
    "audit:access": "node scripts/audit-admin-access-branch.mjs",
    "db:import": "node scripts/import-backup-to-postgres.mjs",
    "db:smoke": "node scripts/postgres-smoke-check.mjs",
    "business:clean-start": "node scripts/clean-business-start.mjs"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@vercel/blob": "^2.6.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bwip-js": "^4.11.2",
    "nepali-date-converter": "^3.4.0",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "twilio": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
